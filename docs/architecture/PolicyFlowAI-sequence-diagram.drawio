<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="2szG0zCkuM-TFVsYeE_F">
    <mxGraphModel dx="2060" dy="1316" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;mermaid\nsequenceDiagram\n    autonumber\n\n    actor Employee\n    actor Reviewer\n    actor Admin\n\n    participant UI as React Frontend\n    participant Edge as Cloudflare\n    participant ALB as AWS ALB\n    participant API as FastAPI\n    participant Auth as Auth and RBAC\n    participant Service as Application Services\n    participant Graph as LangGraph\n    participant RAG as Hybrid RAG\n    participant FTS as PostgreSQL FTS\n    participant Vector as pgvector\n    participant RRF as RRF Fusion\n    participant Reranker as Cohere or BGE\n    participant Gateway as Model Gateway\n    participant LLM as OpenAI\n    participant Rules as Deterministic Rules\n    participant Citation as Citation Validator\n    participant BusinessDB as PostgreSQL Business Data\n    participant PolicyDB as PostgreSQL Policy Data\n    participant CheckpointDB as PostgreSQL Checkpoints\n    participant AuditDB as PostgreSQL Audit\n    participant Redis as Redis\n    participant Obs as Observability\n\n    Note over Employee,Obs: PolicyFlow AI end-to-end sequence\n    Note over Auth: Current POC uses demo role headers&lt;br/&gt;Production target uses OIDC and RBAC\n    Note over BusinessDB,CheckpointDB: Business truth and workflow state are stored separately\n\n    %% Policy ingestion\n    rect rgb(235, 245, 255)\n        Note over Admin,PolicyDB: Policy ingestion\n\n        Admin-&gt;&gt;Edge: Start policy ingestion\n        Edge-&gt;&gt;ALB: Forward HTTPS request\n        ALB-&gt;&gt;API: POST /api/v1/admin/policies/ingest\n        API-&gt;&gt;Auth: Authorize administrator\n\n        alt Administrator authorized\n            Auth--&gt;&gt;API: Authorized\n            API-&gt;&gt;Redis: Acquire ingestion lock\n\n            alt Lock acquired\n                Redis--&gt;&gt;API: Lock token\n                API-&gt;&gt;Service: Load and validate policy document\n                Service-&gt;&gt;Service: Calculate content hash\n                Service-&gt;&gt;PolicyDB: Check policy version and hash\n\n                alt Policy is unchanged\n                    PolicyDB--&gt;&gt;Service: Existing identical policy\n                    Service-&gt;&gt;Redis: Release lock\n                    Service--&gt;&gt;API: Unchanged\n                    API--&gt;&gt;Admin: Policy already indexed\n                else Policy is new or changed\n                    Service-&gt;&gt;Service: Create section-aware chunks\n                    Service-&gt;&gt;Gateway: Generate embeddings\n                    Gateway-&gt;&gt;LLM: Embedding request\n                    LLM--&gt;&gt;Gateway: Embedding vectors\n                    Gateway--&gt;&gt;Service: Validated vectors\n\n                    Service-&gt;&gt;PolicyDB: Begin transaction\n                    Service-&gt;&gt;PolicyDB: Store document and chunks\n                    Service-&gt;&gt;PolicyDB: Store FTS data and vectors\n                    Service-&gt;&gt;PolicyDB: Activate policy version\n                    PolicyDB--&gt;&gt;Service: Commit successful\n\n                    Service-&gt;&gt;AuditDB: Record ingestion event\n                    Service-&gt;&gt;Redis: Release lock\n                    Service-&gt;&gt;Obs: Record ingestion metrics\n                    Service--&gt;&gt;API: Ingestion completed\n                    API--&gt;&gt;Admin: Policy indexed\n                end\n            else Lock unavailable\n                Redis--&gt;&gt;API: Ingestion already running\n                API--&gt;&gt;Admin: 409 ingestion conflict\n            end\n        else Administrator unauthorized\n            Auth--&gt;&gt;API: Forbidden\n            API--&gt;&gt;Admin: 403 forbidden\n        end\n    end\n\n    %% Policy question and answer\n    rect rgb(240, 255, 240)\n        Note over Employee,Obs: Policy question and grounded answer\n\n        Employee-&gt;&gt;UI: Ask policy question\n        UI-&gt;&gt;Edge: Submit question\n        Edge-&gt;&gt;ALB: Apply edge controls\n        ALB-&gt;&gt;API: POST /api/v1/policy/query\n        API-&gt;&gt;Auth: Validate employee identity\n\n        alt Employee authorized\n            Auth--&gt;&gt;API: Authorized\n            API-&gt;&gt;Service: Validate policy question\n            Service-&gt;&gt;Graph: Start Policy Q&amp;A graph\n            Graph-&gt;&gt;CheckpointDB: Save workflow state\n            Graph-&gt;&gt;Graph: Build deterministic metadata filters\n            Graph-&gt;&gt;RAG: Retrieve active policy evidence\n\n            par Lexical search\n                RAG-&gt;&gt;FTS: Search exact policy terms\n                FTS-&gt;&gt;PolicyDB: Query active policy chunks\n                PolicyDB--&gt;&gt;FTS: Lexical matches\n                FTS--&gt;&gt;RAG: Ranked lexical results\n            and Vector search\n                RAG-&gt;&gt;Vector: Search semantic embeddings\n                Vector-&gt;&gt;PolicyDB: Query policy vectors\n                PolicyDB--&gt;&gt;Vector: Semantic matches\n                Vector--&gt;&gt;RAG: Ranked vector results\n            end\n\n            RAG-&gt;&gt;RRF: Fuse lexical and vector rankings\n            RRF--&gt;&gt;RAG: Fused candidates\n            RAG-&gt;&gt;Reranker: Rerank candidates\n\n            alt Reranker available\n                Reranker--&gt;&gt;RAG: Top evidence chunks\n            else Reranker unavailable\n                Reranker--&gt;&gt;RAG: Failure\n                RAG-&gt;&gt;RAG: Use configured RRF fallback\n                RAG-&gt;&gt;Obs: Record reranker fallback\n            end\n\n            RAG--&gt;&gt;Graph: Ranked policy evidence\n\n            alt No sufficient evidence\n                Graph-&gt;&gt;CheckpointDB: Save safe-stop state\n                Graph-&gt;&gt;Obs: Record insufficient evidence\n                Graph--&gt;&gt;Service: INSUFFICIENT_INFORMATION\n                Service--&gt;&gt;API: Safe abstention\n                API--&gt;&gt;UI: Insufficient policy evidence\n                UI--&gt;&gt;Employee: Display safe abstention\n            else Evidence available\n                Graph-&gt;&gt;Gateway: Generate grounded structured answer\n                Gateway-&gt;&gt;Redis: Check thread token budget\n\n                alt Token budget available\n                    Redis--&gt;&gt;Gateway: Budget available\n                    Gateway-&gt;&gt;Gateway: Apply input and output guardrails\n                    Gateway-&gt;&gt;LLM: Send question and bounded evidence\n\n                    alt Model response valid\n                        LLM--&gt;&gt;Gateway: Structured answer and citation IDs\n                    else Invalid structured output\n                        LLM--&gt;&gt;Gateway: Invalid response\n                        Gateway-&gt;&gt;LLM: Perform bounded repair retry\n                        LLM--&gt;&gt;Gateway: Repaired structured response\n                    else Timeout or rate limit\n                        LLM--&gt;&gt;Gateway: Timeout or rate-limit error\n                        Gateway-&gt;&gt;LLM: Bounded retry or fallback model\n                        LLM--&gt;&gt;Gateway: Response or final failure\n                    end\n\n                    Gateway-&gt;&gt;Redis: Update token usage\n                    Gateway-&gt;&gt;Obs: Record model telemetry\n                    Gateway--&gt;&gt;Graph: Validated model output\n\n                    Graph-&gt;&gt;Citation: Validate citation IDs\n                    Citation-&gt;&gt;PolicyDB: Load authoritative policy chunks\n                    PolicyDB--&gt;&gt;Citation: Policy metadata and content\n                    Citation-&gt;&gt;Citation: Validate status, date and version\n                    Citation-&gt;&gt;Citation: Build excerpts from stored content\n\n                    alt Citations valid\n                        Citation--&gt;&gt;Graph: Verified citations\n                        Graph-&gt;&gt;CheckpointDB: Save completed state\n                        Graph-&gt;&gt;AuditDB: Record policy answer event\n                        Graph--&gt;&gt;Service: Grounded answer\n                        Service--&gt;&gt;API: Answer with citations\n                        API--&gt;&gt;UI: Grounded response\n                        UI--&gt;&gt;Employee: Display answer and sources\n                    else Citations invalid\n                        Citation--&gt;&gt;Graph: Citation failure\n                        Graph-&gt;&gt;CheckpointDB: Save safe-stop state\n                        Graph-&gt;&gt;Obs: Record citation failure\n                        Graph--&gt;&gt;Service: Safe abstention\n                        Service--&gt;&gt;API: INSUFFICIENT_INFORMATION\n                        API--&gt;&gt;UI: Unable to verify citations\n                        UI--&gt;&gt;Employee: Display safe abstention\n                    end\n                else Token budget exceeded\n                    Redis--&gt;&gt;Gateway: Budget exceeded\n                    Gateway--&gt;&gt;Graph: Controlled failure\n                    Graph--&gt;&gt;Service: Service unavailable\n                    Service--&gt;&gt;API: 503 controlled response\n                    API--&gt;&gt;UI: Retry later\n                end\n            end\n        else Employee unauthorized\n            Auth--&gt;&gt;API: Forbidden\n            API--&gt;&gt;UI: 403 forbidden\n        end\n    end\n\n    %% Expense assessment\n    rect rgb(255, 250, 230)\n        Note over Employee,Obs: Expense submission and compliance assessment\n\n        Employee-&gt;&gt;UI: Submit expense details\n        UI-&gt;&gt;Edge: Send expense and idempotency key\n        Edge-&gt;&gt;ALB: Forward request\n        ALB-&gt;&gt;API: POST /api/v1/expenses\n        API-&gt;&gt;Auth: Validate employee identity\n        API-&gt;&gt;Service: Create expense\n\n        Service-&gt;&gt;BusinessDB: Check idempotency key\n\n        alt Key reused with different payload\n            BusinessDB--&gt;&gt;Service: Idempotency conflict\n            Service--&gt;&gt;API: Conflict\n            API--&gt;&gt;UI: 409 conflict\n            UI--&gt;&gt;Employee: Display conflict\n        else Existing matching request\n            BusinessDB--&gt;&gt;Service: Existing result\n            Service--&gt;&gt;API: Existing assessment\n            API--&gt;&gt;UI: Existing response\n            UI--&gt;&gt;Employee: Display assessment\n        else New expense\n            Service-&gt;&gt;BusinessDB: Persist expense\n            BusinessDB--&gt;&gt;Service: Expense ID and thread ID\n            Service-&gt;&gt;Graph: Start Expense graph\n            Graph-&gt;&gt;CheckpointDB: Save workflow checkpoint\n            Graph-&gt;&gt;Graph: Validate required fields\n\n            alt Required fields missing\n                Graph-&gt;&gt;CheckpointDB: Save clarification state\n                Graph--&gt;&gt;Service: Missing fields\n                Service-&gt;&gt;BusinessDB: Mark PENDING_CLARIFICATION\n                Service--&gt;&gt;API: Request clarification\n                API--&gt;&gt;UI: Missing field list\n                UI--&gt;&gt;Employee: Request missing information\n\n                Employee-&gt;&gt;UI: Provide clarification\n                UI-&gt;&gt;Edge: Submit clarification\n                Edge-&gt;&gt;ALB: Forward request\n                ALB-&gt;&gt;API: POST /api/v1/expenses/{id}/clarifications\n                API-&gt;&gt;Service: Continue assessment\n                Service-&gt;&gt;BusinessDB: Update expense\n                Service-&gt;&gt;Graph: Resume with thread ID\n                Graph-&gt;&gt;CheckpointDB: Load checkpoint\n            else Fields complete\n                Graph-&gt;&gt;Graph: Continue assessment\n            end\n\n            Graph-&gt;&gt;RAG: Retrieve applicable policy evidence\n\n            par Lexical retrieval\n                RAG-&gt;&gt;FTS: Search policy terms\n                FTS-&gt;&gt;PolicyDB: Query filtered chunks\n                PolicyDB--&gt;&gt;FTS: Lexical candidates\n                FTS--&gt;&gt;RAG: Ranked lexical results\n            and Semantic retrieval\n                RAG-&gt;&gt;Vector: Search embeddings\n                Vector-&gt;&gt;PolicyDB: Query filtered vectors\n                PolicyDB--&gt;&gt;Vector: Semantic candidates\n                Vector--&gt;&gt;RAG: Ranked semantic results\n            end\n\n            RAG-&gt;&gt;RRF: Fuse rankings\n            RRF--&gt;&gt;RAG: Fused candidates\n            RAG-&gt;&gt;Reranker: Rerank candidates\n            Reranker--&gt;&gt;RAG: Top policy evidence\n            RAG--&gt;&gt;Graph: Ranked evidence\n\n            alt No sufficient policy evidence\n                Graph-&gt;&gt;Rules: Evaluate insufficient evidence\n                Rules--&gt;&gt;Graph: INSUFFICIENT_INFORMATION\n            else Policy evidence available\n                Graph-&gt;&gt;Gateway: Extract structured policy rule\n                Gateway-&gt;&gt;LLM: Send expense facts and evidence\n                LLM--&gt;&gt;Gateway: Structured policy rule\n                Gateway-&gt;&gt;Gateway: Validate output schema\n                Gateway--&gt;&gt;Graph: Validated policy rule\n\n                Graph-&gt;&gt;Citation: Validate policy citations\n                Citation-&gt;&gt;PolicyDB: Verify source records\n                PolicyDB--&gt;&gt;Citation: Authoritative policy records\n                Citation--&gt;&gt;Graph: Valid citations or failure\n\n                Graph-&gt;&gt;Rules: Apply deterministic controls\n                Note over Rules: Decimal amount comparison&lt;br/&gt;receipt requirements&lt;br/&gt;policy conditions&lt;br/&gt;confidence routing\n                Rules--&gt;&gt;Graph: Decision, confidence and variance\n            end\n\n            alt COMPLIANT\n                Graph-&gt;&gt;CheckpointDB: Save completed state\n                Graph--&gt;&gt;Service: COMPLIANT\n                Service-&gt;&gt;BusinessDB: Persist assessment\n                Service-&gt;&gt;AuditDB: Record assessment event\n                Service--&gt;&gt;API: Compliant response\n                API--&gt;&gt;UI: Decision and citations\n                UI--&gt;&gt;Employee: Display COMPLIANT\n            else NON_COMPLIANT\n                Graph-&gt;&gt;CheckpointDB: Save completed state\n                Graph--&gt;&gt;Service: NON_COMPLIANT\n                Service-&gt;&gt;BusinessDB: Persist assessment\n                Service-&gt;&gt;AuditDB: Record assessment event\n                Service--&gt;&gt;API: Non-compliant response\n                API--&gt;&gt;UI: Decision and citations\n                UI--&gt;&gt;Employee: Display NON_COMPLIANT\n            else INSUFFICIENT_INFORMATION\n                Graph-&gt;&gt;CheckpointDB: Save safe-stop state\n                Graph--&gt;&gt;Service: Insufficient information\n                Service-&gt;&gt;BusinessDB: Persist safe assessment\n                Service-&gt;&gt;AuditDB: Record insufficient-evidence event\n                Service--&gt;&gt;API: Safe abstention\n                API--&gt;&gt;UI: More information required\n                UI--&gt;&gt;Employee: Display next action\n            else NEEDS_REVIEW\n                Graph-&gt;&gt;CheckpointDB: Save assessment state\n                Graph--&gt;&gt;Service: NEEDS_REVIEW\n                Service-&gt;&gt;BusinessDB: Persist assessment and variance\n                Service-&gt;&gt;AuditDB: Record review-required event\n                Service--&gt;&gt;API: Exception justification required\n                API--&gt;&gt;UI: NEEDS_REVIEW response\n                UI--&gt;&gt;Employee: Display exception option\n            end\n        end\n    end\n\n    %% Human review\n    rect rgb(255, 235, 245)\n        Note over Employee,Obs: Exception submission and human review\n\n        Employee-&gt;&gt;UI: Submit exception justification\n        UI-&gt;&gt;Edge: Send exception request\n        Edge-&gt;&gt;ALB: Forward request\n        ALB-&gt;&gt;API: POST /api/v1/expenses/{id}/exceptions\n        API-&gt;&gt;Auth: Validate employee identity\n        API-&gt;&gt;Service: Submit exception\n\n        Service-&gt;&gt;BusinessDB: Load expense and assessment\n\n        alt Expense not eligible\n            BusinessDB--&gt;&gt;Service: Not NEEDS_REVIEW\n            Service--&gt;&gt;API: Exception ineligible\n            API--&gt;&gt;UI: 409 not eligible\n            UI--&gt;&gt;Employee: Display error\n        else Expense eligible\n            Service-&gt;&gt;BusinessDB: Create exception record\n            Service-&gt;&gt;AuditDB: Record EXCEPTION_CREATED\n\n            Service-&gt;&gt;Gateway: Generate neutral review summary\n            Gateway-&gt;&gt;LLM: Send facts, evidence and justification\n            LLM--&gt;&gt;Gateway: Structured summary\n            Gateway--&gt;&gt;Service: Validated summary\n\n            Note over Gateway,Service: The model summarizes evidence&lt;br/&gt;It cannot approve or reject\n\n            Service-&gt;&gt;BusinessDB: Store pending review state\n            Service-&gt;&gt;Graph: Start Exception HITL graph\n            Graph-&gt;&gt;CheckpointDB: Save checkpoint\n            Graph-&gt;&gt;Graph: Interrupt for human review\n            Graph-&gt;&gt;CheckpointDB: Persist interrupt state\n            Graph--&gt;&gt;Service: Waiting for reviewer\n            Service-&gt;&gt;AuditDB: Record HUMAN_REVIEW_INTERRUPTED\n            Service--&gt;&gt;API: Exception pending review\n            API--&gt;&gt;UI: WAIT_FOR_REVIEW\n            UI--&gt;&gt;Employee: Display pending status\n        end\n\n        Reviewer-&gt;&gt;UI: Open pending review queue\n        UI-&gt;&gt;Edge: Request pending reviews\n        Edge-&gt;&gt;ALB: Forward request\n        ALB-&gt;&gt;API: GET /api/v1/reviews/pending\n        API-&gt;&gt;Auth: Validate reviewer identity\n\n        alt Reviewer authorized\n            Auth--&gt;&gt;API: Authorized\n            API-&gt;&gt;Service: Load pending reviews\n            Service-&gt;&gt;BusinessDB: Query pending exceptions\n            BusinessDB--&gt;&gt;Service: Pending review records\n            Service--&gt;&gt;API: Pending review list\n            API--&gt;&gt;UI: Review queue\n            UI--&gt;&gt;Reviewer: Display pending reviews\n\n            Reviewer-&gt;&gt;UI: Open review details\n            UI-&gt;&gt;Edge: Request review detail\n            Edge-&gt;&gt;ALB: Forward request\n            ALB-&gt;&gt;API: GET /api/v1/reviews/{id}\n            API-&gt;&gt;Service: Load review context\n            Service-&gt;&gt;BusinessDB: Read expense and exception\n            Service-&gt;&gt;PolicyDB: Revalidate policy citations\n            PolicyDB--&gt;&gt;Service: Current policy evidence\n            Service--&gt;&gt;API: Grounded review context\n            API--&gt;&gt;UI: Facts, variance, citations and summary\n            UI--&gt;&gt;Reviewer: Display review details\n\n            Reviewer-&gt;&gt;UI: Submit review decision\n            UI-&gt;&gt;Edge: Send decision\n            Edge-&gt;&gt;ALB: Forward request\n            ALB-&gt;&gt;API: POST /api/v1/reviews/{id}/decision\n            API-&gt;&gt;Auth: Revalidate reviewer authority\n            API-&gt;&gt;Service: Apply human decision\n\n            Service-&gt;&gt;BusinessDB: Begin transaction\n            Service-&gt;&gt;BusinessDB: Lock exception record\n            Service-&gt;&gt;BusinessDB: Verify current state\n\n            alt Already finalized\n                BusinessDB--&gt;&gt;Service: Final-state conflict\n                Service--&gt;&gt;API: 409 conflict\n                API--&gt;&gt;UI: Refresh current status\n            else Valid human decision\n                Service-&gt;&gt;BusinessDB: Insert review\n                Service-&gt;&gt;BusinessDB: Update authoritative status\n                Service-&gt;&gt;AuditDB: Record REVIEWER_ACTION\n                Service-&gt;&gt;BusinessDB: Commit transaction\n\n                Note over BusinessDB,Service: The committed human decision&lt;br/&gt;is the authoritative result\n\n                Service-&gt;&gt;Graph: Resume HITL graph\n                Graph-&gt;&gt;CheckpointDB: Load interrupted checkpoint\n\n                alt APPROVE\n                    Graph-&gt;&gt;Graph: Finalize APPROVED\n                else REJECT\n                    Graph-&gt;&gt;Graph: Finalize REJECTED\n                else REQUEST_MORE_INFORMATION\n                    Graph-&gt;&gt;Graph: Route to information-required state\n                end\n\n                Graph-&gt;&gt;CheckpointDB: Save resumed state\n                Graph--&gt;&gt;Service: Resume completed\n                Service-&gt;&gt;BusinessDB: Mark reconciliation complete\n                Service-&gt;&gt;AuditDB: Record WORKFLOW_RESUMED\n                Service--&gt;&gt;API: Human decision outcome\n                API--&gt;&gt;UI: Updated status\n                UI--&gt;&gt;Reviewer: Display committed result\n            end\n        else Reviewer unauthorized\n            Auth--&gt;&gt;API: Forbidden\n            API--&gt;&gt;UI: 403 forbidden\n        end\n    end\n\n    %% More information loop\n    rect rgb(245, 240, 255)\n        Note over Employee,Reviewer: Request-more-information loop\n\n        opt Reviewer requested more information\n            Employee-&gt;&gt;UI: View exception status\n            UI-&gt;&gt;Edge: Request latest status\n            Edge-&gt;&gt;ALB: Forward request\n            ALB-&gt;&gt;API: GET /api/v1/expenses/{id}\n            API-&gt;&gt;BusinessDB: Read authoritative status\n            BusinessDB--&gt;&gt;API: MORE_INFORMATION_REQUIRED\n            API--&gt;&gt;UI: Reviewer comments\n            UI--&gt;&gt;Employee: Display information request\n\n            Employee-&gt;&gt;UI: Submit additional information\n            UI-&gt;&gt;Edge: Send additional information\n            Edge-&gt;&gt;ALB: Forward request\n            ALB-&gt;&gt;API: POST /api/v1/exceptions/{id}/information\n            API-&gt;&gt;Auth: Validate employee identity\n            API-&gt;&gt;Service: Add information\n            Service-&gt;&gt;BusinessDB: Append information history\n            Service-&gt;&gt;AuditDB: Record information event\n            Service-&gt;&gt;Graph: Resume review workflow\n            Graph-&gt;&gt;CheckpointDB: Load thread checkpoint\n            Graph-&gt;&gt;Graph: Interrupt for reviewer again\n            Graph-&gt;&gt;CheckpointDB: Save new interrupt state\n            Graph--&gt;&gt;Service: Waiting for reviewer\n            Service-&gt;&gt;BusinessDB: Set PENDING_REVIEW\n            Service--&gt;&gt;API: Review pending again\n            API--&gt;&gt;UI: WAIT_FOR_REVIEW\n            UI--&gt;&gt;Employee: Display pending status\n        end\n    end\n\n    %% Failure reconciliation\n    rect rgb(255, 245, 235)\n        Note over Service,Obs: Checkpoint reconciliation\n\n        opt Human decision committed but graph resume fails\n            Service-&gt;&gt;Graph: Resume workflow\n            Graph-&gt;&gt;CheckpointDB: Load or update checkpoint\n            CheckpointDB--&gt;&gt;Graph: Checkpoint failure\n            Graph--&gt;&gt;Service: Resume failed\n\n            Service-&gt;&gt;BusinessDB: Preserve human decision\n            Service-&gt;&gt;BusinessDB: Mark reconciliation pending\n            Service-&gt;&gt;Obs: Emit reconciliation alert\n            Service--&gt;&gt;API: Return authoritative human result\n\n            Note over BusinessDB,Obs: A retry worker or secured administrative action&lt;br/&gt;should reconcile the checkpoint later\n        end\n    end\n\n    %% Operational health\n    rect rgb(240, 240, 240)\n        Note over ALB,Obs: Health and observability\n\n        ALB-&gt;&gt;API: GET /health\n        API--&gt;&gt;ALB: Process health\n\n        ALB-&gt;&gt;API: GET /ready\n        API-&gt;&gt;BusinessDB: Check PostgreSQL\n        BusinessDB--&gt;&gt;API: Database status\n        API-&gt;&gt;Redis: Check Redis\n        Redis--&gt;&gt;API: Redis status\n\n        alt Dependencies ready\n            API--&gt;&gt;ALB: 200 ready\n        else Dependency unavailable\n            API-&gt;&gt;Obs: Record readiness failure\n            API--&gt;&gt;ALB: 503 not ready\n        end\n\n        API-&gt;&gt;Obs: API and correlation telemetry\n        Graph-&gt;&gt;Obs: Node, interrupt and resume telemetry\n        RAG-&gt;&gt;Obs: Retrieval and ranking telemetry\n        Gateway-&gt;&gt;Obs: Model, token and latency telemetry\n        Citation-&gt;&gt;Obs: Citation validation telemetry\n\n        Note over Obs: Structured logs go to CloudWatch&lt;br/&gt;AI trace metadata can go to LangSmith\n    end\n```&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="x42icSyTfcvQNkcy22V4-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="x42icSyTfcvQNkcy22V4-2" parent="x42icSyTfcvQNkcy22V4-1" style="html=1;rounded=0;strokeColor=none;fillColor=#ebf5ff;fillOpacity=100;pointerEvents=0;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" value="" vertex="1">
