        <mxCell id="x42icSyTfcvQNkcy22V4-3" parent="x42icSyTfcvQNkcy22V4-1" style="html=1;rounded=0;strokeColor=none;fillColor=#f0fff0;fillOpacity=100;pointerEvents=0;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" value="" vertex="1">
